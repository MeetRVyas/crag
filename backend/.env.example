FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///./data/crag.db
REDIS_URL=redis://redis:6379/0

PROVIDER=ollama # or huggingface or anthropic or groq
EMBEDDING_PROVIDER=ollama # or huggingface

TAVILY_API_KEY=your-tavily-api-key
HF_TOKEN=your-hf-token

UPLOAD_DIR=/tmp/sessions
MAX_FILE_SIZE_MB=10

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=mistral:v0.3
EMBEDDING_MODEL=embeddinggemma:300m

EMBEDDING_FALLBACK=ollama

OLLAMA_ALLOWED_LLM_MODELS=["mistral:v0.3"]
OLLAMA_ALLOWED_EMBEDDING_MODELS=["embeddinggemma:300m"]

# HuggingFace
# HUGGINGFACEHUB_API_TOKEN=your-huggingface-api-key
## CPU
# LLM_MODEL=Qwen/Qwen2.5-3B-Instruct # CPU
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2 # CPU
## API
# LLM_MODEL=HuggingFaceH4/zephyr-7b-beta
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 # Not recommended (rate limited)


# Google
# GOOGLE_API_KEY=your-google-api-key
# LLM_MODEL=gemini-3.1-flash-lite
# EMBEDDING_MODEL=models/gemini-embedding-001


# Groq LLM
# GROQ_API_KEY=your-groq-api-key
# LLM_MODEL=llama-3.1-8b-instant


# Anthropic Claude
# ANTHROPIC_API_KEY=your-anthropic-api-key
# LLM_MODEL=claude-haiku-4-5-20251001